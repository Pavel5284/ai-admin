DATABASE_URL=postgres://app:app@localhost:5432/admin
CRM_URL=http://localhost:4000
TELEGRAM_BOT_TOKEN=
# Лимит сообщений на пользователя: защита бюджета LLM от спама
TG_RATE_LIMIT=20
TG_RATE_WINDOW_MS=60000
BUSINESS_TZ=Europe/Moscow

# Облачная LLM
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b
LLM_JSON_MODE=1
LLM_TIMEOUT_MS=20000
LLM_CACHE=1
# Живой стиль: модель добавляет короткую вводную фразу, факты и решение остаются в коде
LLM_HUMANIZE=1
LLM_STYLE_TEMPERATURE=0.7
# Отдельная быстрая модель для стиля. Пусто — основная LLM_MODEL.
# На Groq qwen быстрее reasoning-модели и не тратит её лимит.
LLM_STYLE_MODEL=qwen/qwen3.8-27b
# Для reasoning-моделей Groq: low заметно ускоряет короткую фразу.
# Для qwen поле не нужно; если провайдер не поддерживает — оставьте пустым.
LLM_STYLE_REASONING_EFFORT=
# Стиль не должен задерживать ответ: при таймауте сразу шаблон.
LLM_STYLE_TIMEOUT_MS=5000
# 1 — не повторять стилевой вызов и не тратить лимит основной модели.
LLM_STYLE_FAST_FAIL=1
EMBED_BASE_URL=https://api.mistral.ai/v1
EMBED_API_KEY=
# Векторный поиск по базе знаний (порог калибруется скриптом scripts/kb-threshold.ts)
KB_DIST_MAX=0.2
EMBED_MODEL=mistral-embed

